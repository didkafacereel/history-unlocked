# Public URL of the daily-generated manifest (see pipeline/README.md).
# Leave unset to run fully offline from the bundled sample manifest.
EXPO_PUBLIC_MANIFEST_URL=https://USER.github.io/history-unlocked/manifest.json

# Origin the share cards print and deep links point at. Without it a shared
# card carries no link, because the historyunlocked:// scheme is useless to
# anyone who does not already have the app.
EXPO_PUBLIC_WEB_ORIGIN=https://USER.github.io/history-unlocked

# Where "Missing something from this day?" sends a Pro reader's suggestion.
# Set EITHER of these; with neither, the button does not render at all.
#   FORM_URL wins, and receives the date as ?date=MM-DD
#   EMAIL falls back to the device mail composer, prefilled with the date and
#   a digest of what the day already holds
EXPO_PUBLIC_FEEDBACK_FORM_URL=
EXPO_PUBLIC_FEEDBACK_EMAIL=

# Firebase — accounts (Google + email link). All four come from the Firebase
# console: Project settings → General. Not secrets: they identify a project and
# ship inside every APK. Without apiKey, projectId AND appId the app reports
# "not signed in" everywhere rather than half-initialising.
#   AUTH_DOMAIN is <project-id>.firebaseapp.com
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=history-unlocked-fa9a9.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=history-unlocked-fa9a9
EXPO_PUBLIC_FIREBASE_APP_ID=

# Founders backend — numbered seats and the kept-day claims. Both are GLOBAL
# facts, so without an endpoint the app runs a device-local stand-in and says
# so on screen. Never ship the stand-in as if it were real — and a release
# build no longer offers Lifetime at all without it (lifetimeIsSellable).
# After `npm run deploy` in firebase/functions it is:
#   https://europe-west1-history-unlocked-fa9a9.cloudfunctions.net/api
EXPO_PUBLIC_FOUNDERS_API=

# Readers' choice voting. Without an endpoint the app runs a device-local
# stand-in that counts only this phone — so the tally never crosses the
# threshold and the ballot correctly shows its "too few votes" state.
EXPO_PUBLIC_VOTING_API=

# Google sign-in. The WEB client id from Google Cloud, even on Android — using
# the Android client id here is the usual cause of DEVELOPER_ERROR. Without it
# the app falls back to a local stand-in account and says so on screen.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# RevenueCat public SDK keys. Absent keys run the dev entitlement provider,
# which works on web and needs no billing account.
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=
