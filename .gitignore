# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Pipeline run logs — long builds are teed here so a failure is readable.
*.log

# Generated by `pipeline:publish` — byte-for-byte identical to docs/, and only
# read by the Expo dev server. Tracking it would duplicate 23 MB per publish.
/public/manifest.json
/public/quizzes.json

# Working state of the backdrop repair: proposals, the tried-log, review notes.
# Regenerated by every `pipeline:symbols --propose`. The quiz batch results in
# the same folder are NOT ignored — those are the output of paid API runs and
# rebuilding the question bank without them costs money again.
pipeline/drafts/symbol-*.json

# Per-machine editor state.
.claude/settings.local.json

# Account index — usernames and where things are registered. The repository is
# PUBLIC; this must never be pushed. Secrets do not live in it either, but the
# email addresses alone are worth keeping out.
ACCOUNTS.local.md
*.local.md

# Downloaded originals for pipeline/build-collage.ts. Rebuildable, and the
# prints themselves are committed as launch-backdrop.jpg.
.cache/

# Firebase Android config. Google says this is not a secret — its values ship
# inside every APK and anyone can read them out. It stays out anyway, because
# this repository is public: a committed config is scraped in minutes, and if a
# Firestore rule is ever wrong it turns a decompile into a copy-paste. The
# build gets it from an EAS file variable instead.
google-services.json
GoogleService-Info.plist

# Cloud Functions build output and deps
firebase/functions/lib/
firebase/functions/node_modules/
firebase/.firebaserc
