      tl.fromTo("#s8-fade", { opacity: 0 }, { opacity: 1, duration: 0.3, ease: "power1.out" }, t8);
      tl.fromTo("#s8-icon", { opacity: 0, scale: 0.6 }, { opacity: 1, scale: 1, duration: 0.6, ease: "back.out(1.8)" }, t8 + 0.15);
