      tl.fromTo("#s8-cta", { scale: 1 }, { scale: 1.07, duration: 0.45, ease: "sine.inOut", yoyo: true, repeat: 3, immediateRender: false }, G.s8b.start + 0.55);
      tl.fromTo("#s8-note", { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.5, ease: "sine.out" }, within("s8b", 0.35));
      tl.fromTo("#s8-credit", { opacity: 0 }, { opacity: 1, duration: 0.5, ease: "sine.out" }, G.s8a.end + 0.2);
      tl.fromTo("#s8-content", { opacity: 1 }, { opacity: 0, duration: 0.4, ease: "power2.in" }, T.total - 0.45);

      // captions
      GROUPS.forEach(function (g, i) {
        var sel = "#cg-" + i;
        tl.fromTo(sel, { opacity: 0, scale: 0.9 }, { opacity: 1, scale: 1, duration: 0.14, ease: "back.out(1.7)" }, g.start);
        tl.to(sel, { opacity: 0, duration: 0.1, ease: "power2.in" }, g.end - 0.1);
        tl.set(sel, { opacity: 0, visibility: "hidden" }, g.end);
      });

      window.__timelines["main"] = tl;
      tl.seek(0);
