{
  "expo": {
    "name": "History Unlocked",
    "slug": "history-unlocked",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "historyunlocked",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/196c0c9c-4086-4afd-b3b8-c9213ff7c6b4"
    },
    "android": {
      "package": "com.historyunlocked.app",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#06070A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": {
            "scheme": "https",
            "host": "history-unlocked-fa9a9.firebaseapp.com",
            "pathPrefix": "/__/auth/links"
          },
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06070A",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 180
          }
        }
      ],
      "expo-sharing",
      "@react-native-google-signin/google-signin",
      "expo-image",
      "expo-web-browser",
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "196c0c9c-4086-4afd-b3b8-c9213ff7c6b4"
      }
    }
  }
}
