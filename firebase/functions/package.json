{
  "name": "history-unlocked-founders",
  "description": "Founder seats and kept dates for History Unlocked",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "serve": "npm run build && npx -y firebase-tools@15 emulators:start --only functions,firestore,auth --project demo-history-unlocked",
    "test:emulator": "node scripts/emulator-smoke.mjs",
    "deploy": "npx -y firebase-tools@15 deploy --only functions,firestore:rules",
    "secret:webhook": "npx -y firebase-tools@15 functions:secrets:set REVENUECAT_WEBHOOK_SECRET",
    "secret:webhook:show": "npx -y firebase-tools@15 functions:secrets:access REVENUECAT_WEBHOOK_SECRET"
  },
  "dependencies": {
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.3.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
